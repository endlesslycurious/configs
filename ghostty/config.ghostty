# Ghostty configuration
# Based on the old iTerm2 setup (Catppuccin, JetBrainsMono Nerd Font)

# Theme (static; switch to "Catppuccin Frappe" to use the dark flavour)
theme = Catppuccin Latte

# Font
font-family = JetBrainsMono Nerd Font Mono
font-size = 12

# Terminal
term = xterm-256color
scrollback-limit = 1000000000