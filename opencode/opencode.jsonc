{
  "$schema": "https://opencode.ai/config.json",

  // Enable language servers
  "lsp": true,

  // default model
  "model": "deepseek/deepseek-v4-flash",

  "provider": {
    // Remote hosted models
    "remote": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Remote",
      "options": {
        "baseURL": "{env:REMOTE_BASE_URL}",
      },
      "models": {
        "gemma4_26B": {
          "name": "Gemma 4 26B"
        },
        "gemma4_31B": {
          "name": "Gemma 4 31B"
        },
        "glm4_7_Q8_K_XL": {
          "name": "GLM 4.7 Q8 K XL"
        },
        "ornith_35b_Q4": {
          "name": "Ornith 35B Q4"
        },
        "qwen3_5_122B": {
          "name": "Qwen 3.5 122B"
        },
        "qwen3_6_27B_Q8_MTP": {
          "name": "Qwen 3.6 27B Q8 MTP"
        },
        "qwen3_6_35B_A3B": {
          "name": "Qwen 3.6 35B A3B"
        },
        "qwen3_coder_next": {
          "name": "Qwen 3 Coder Next"
        }
      }
    }
  },

  // Agent settings: default model by mode
  "agent": {
    "build": {
      "model": "deepseek/deepseek-v4-flash",
    },
    "plan": {
      "model": "deepseek/deepseek-v4-pro",
    }
  },

  // Enable context compaction and pruning
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },

  // Deny Git (write) actions and tk close/rm
  "permission": {
    "bash": {
      "git add*": "deny",
      "git commit*": "deny",
      "git merge*": "deny",
      "git rebase*": "deny",
      "git cherry-pick*": "deny",
      "git push*": "deny",
      "git pull*": "deny",
      "git reset*": "deny",
      "tk close*": "deny",
      "tk rm": "deny"
    }
  }
}
