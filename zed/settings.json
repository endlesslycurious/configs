// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "show_whitespaces": "all",
  "agent_servers": {
    "opencode": {
      "default_config_options": {
        "mode": "build"
      },
      "type": "registry"
    }
  },
  "cli_default_open_behavior": "new_window",
  "language_models": {
    "opencode": {
      "show_go_models": false
    }
  },
  "project_panel": {
    "dock": "left"
  },
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font Mono"
  },
  "agent": {
    "dock": "right",
    "default_profile": "write",
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "opencode",
      "model": "zen/deepseek-v4-flash"
    },
    "tool_permissions": {
      "default": "confirm",
      "tools": {
        "terminal": {
          "default": "confirm",
          "always_allow": [
            { "pattern": "^cat\\b.*" }, // file contents
            { "pattern": "^file\\b.*" }, // file type
            { "pattern": "^find\\b.*" }, // file search
            { "pattern": "^git\\s+(status|diff|log|show)\\b.*" }, // git inspection commands
            { "pattern": "^head\\b.*" }, // file head
            { "pattern": "^invoke\\b.*" }, // project workflows
            { "pattern": "^ls\\b.*" }, // directory contents
            { "pattern": "^p4\\s+(info|status|diff|changes|opened|fstat|print|filelog|where)\\b.*" }, // perforce inspection commands
            { "pattern": "^pwd\\b.*" }, // current directory
            { "pattern": "^rg\\b.*" }, // rip grep
            { "pattern": "^tail\\b.*" }, // file tail
            { "pattern": "^tk\\s+(ls|ready|show)\\b.*" }, // task viewing
            { "pattern": "^tree\\b.*" }, // directory tree
            { "pattern": "^uv run python -m unittest\\b.*" }, // python unit tests
            { "pattern": "^uv\\s+run\\s+invoke\\b.*" }, // project workflows
            { "pattern": "^wc\\b.*" } // counts
          ],

          "always_deny": [
            { "pattern": "\\b(sudo|gsudo)\\b.*" }, // super user
            { "pattern": "\\bfind\\b.*(?:-exec|-ok|-delete)\\b.*" }, // dangerous find flags
            { "pattern": "^git\\s+(?:-C\\s+\\S+\\s+)?(commit|push|reset|clean|rebase|merge|stash)\\b.*" }, // dangerous git commands
            { "pattern": "^p4\\s+(submit|revert|shelve)\\b.*" } // dangerous perforce commands
          ],
        },
      },
    },
  },
  "auto_install_extensions": {
    "html": true,
    "dockerfile": true,
    "docker-compose": true,
    "catppuccin": true,
    "catppuccin-icons": true,
    "make": true,
    "swift": true
  },
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha"
  },
  "ui_font_size": 16,
  "buffer_font_size": 12.0,
  "languages": {
    "Swift": {
      "formatter": {
        "external": {
          "command": "swiftformat",
          "arguments": ["stdin", "--stdinpath", "{buffer_path}"],
        },
      },
      "format_on_save": "on",
    },
  },
}
